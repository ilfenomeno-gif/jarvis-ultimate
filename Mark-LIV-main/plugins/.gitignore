# ── Secrets — never commit ───────────────────────────────────────────────
config/api_keys.json
config/certs/
config/google_calendar_token.json
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Runtime state ────────────────────────────────────────────────────────
memory/*.json
*.log

# ── Editor / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
*.bak
